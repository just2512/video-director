{
  "name": "video-director-remotion-runtime",
  "private": true,
  "type": "module",
  "description": "Isolated Remotion renderer for Video Director",
  "scripts": {
    "render:smoke": "node render.mjs --smoke",
    "typecheck": "tsc --noEmit",
    "build:studio": "esbuild src/StudioCanvasInspector.tsx --bundle --format=iife --platform=browser --target=es2022 --jsx=automatic --outfile=../webui/static/js/film-studio-react.js",
    "build:studio:css": "tailwindcss -i src/film-studio-tailwind.css -o ../webui/static/css/film-studio-tailwind.css --minify"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.536",
    "@remotion/renderer": "4.0.536",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "esbuild": "0.25.5",
    "tailwindcss": "4.1.14",
    "@tailwindcss/cli": "4.1.14"
  }
}
