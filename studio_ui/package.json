{
  "name": "video-director-studio-ui",
  "private": true,
  "type": "module",
  "description": "Independent React 19 + Tailwind 4 build for the Video Director Studio UI.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:studio": "node build.mjs",
    "build:studio:css": "tailwindcss -i film-studio-tailwind.css -o ../webui/static/css/film-studio-tailwind.css --minify"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "esbuild": "0.25.5",
    "tailwindcss": "4.1.14",
    "@tailwindcss/cli": "4.1.14"
  }
}
