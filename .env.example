# video-director 密钥环境变量模板
#
# 目的：把 storage/composer/model_config.json 里的明文 api_key 迁到环境变量，
#       避免密钥明文落盘。storage/ 已在 .gitignore，model_config.json 不会进 git，
#       但迁到环境变量后更彻底（可清空 json 里的 api_key，只留 base_url/model）。
#
# 优先级：环境变量 > model_config.json 文件。设置环境变量后即生效；未设置的
#         角色回退读 model_config.json（个人单机兜底）。
#
# 设置方式（Windows，二选一）：
#   1) 系统环境变量：系统属性 → 环境变量 → 新建（重启服务生效）
#   2) 启动服务前的同一 shell 里 set（当前会话生效）：
#        set VD_LLM_API_KEY=nvapi-xxxx
#        python run_webui.py --port 8501
#
# 复制本文件为 .env（不进 git），填真实 key；或直接把 KV 设进系统环境变量。

# ── 文本大模型（导演/文案/解析）──
VD_LLM_API_KEY=
VD_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
VD_LLM_MODEL=z-ai/glm-5.3-flash

# ── 生图 ──
VD_IMAGE_API_KEY=
VD_IMAGE_BASE_URL=https://apihub.agnes-ai.cn/v1
VD_IMAGE_MODEL=agnes-image-2.5-flash

# ── 生视频 ──
VD_VIDEO_API_KEY=
VD_VIDEO_BASE_URL=https://apihub.agnes-ai.cn/v1
VD_VIDEO_MODEL=agnes-video-2.5-flash

# ── 视觉理解（素材画面分析）──
VD_VISION_API_KEY=
VD_VISION_BASE_URL=https://integrate.api.nvidia.com/v1
VD_VISION_MODEL=z-ai/glm-5.3-flash

# ── 语义检索（Twelve Labs Marengo）──
VD_SEMANTIC_RERANK_API_KEY=
VD_SEMANTIC_RERANK_BASE_URL=https://api.twelvelabs.io
VD_SEMANTIC_RERANK_MODEL=marengo3.5

# ── 视觉验证（Twelve Labs Pegasus）──
VD_VISUAL_QA_API_KEY=
VD_VISUAL_QA_BASE_URL=https://api.twelvelabs.io
VD_VISUAL_QA_MODEL=pegasus1.5

# ── 云端动效（HyperFrames，不配置则走内置 FFmpeg）──
VD_HYPERFRAMES_API_KEY=
VD_HYPERFRAMES_BASE_URL=https://api.hyperframes.dev/v1
VD_HYPERFRAMES_MODEL=hyper-1

# ── 图库（stock 类，key_env 已内置）──
PEXELS_API_KEY=
PIXABAY_API_KEY=
COVERR_API_KEY=

# ── TTS（可选）──
AZURE_API_KEY=
ELEVENLABS_API_KEY=